@model prjMvcCore第四組.Models.TApply

@{
    ViewData["Title"] = "申請詳細資料";

    var statuses = ViewBag.status as IEnumerable<prjMvcCore第四組.Models.TStatus>;

    var status = statuses?
        .FirstOrDefault(s => s.FId == Model.FStatus);
}

<div class="container mt-4">

    <!-- 標題 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>申請詳細資料</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← 返回申請列表
        </a>
    </div>

    <!-- 申請資料 -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">申請資訊</h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="fw-bold">商家名稱</label>
                    <div class="form-control bg-light">
                        @Model.FStoreName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold">申請人</label>
                    <div class="form-control bg-light">
                        @Model.FUser?.FUsername
                    </div>
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="fw-bold">申請日期</label>
                    <div class="form-control bg-light">
                        @Model.FApplyDate
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold">審核狀態</label>

                    <div class="form-control bg-light">

                        @if (status != null)
                        {
                            if (status.FId == 1)
                            {
                                <span class="badge bg-warning text-dark">
                                    @status.FName
                                </span>
                            }
                            else if (status.FId == 2)
                            {
                                <span class="badge bg-success">
                                    @status.FName
                                </span>
                            }
                            else if (status.FId == 3)
                            {
                                <span class="badge bg-danger">
                                    @status.FName
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @status.FName
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                未知狀態
                            </span>
                        }

                    </div>
                </div>

            </div>


            <!-- 其他申請資料 -->
            <hr />

            <h5 class="mb-3">申請內容</h5>

            <div class="row">

                <div class="col-12 mb-3">
                    <label class="fw-bold">申請編號</label>
                    <div class="form-control bg-light">
                        @Model.FId
                    </div>
                </div>

                <!--
                如果 TApply 還有其他欄位，
                可以繼續在這裡放。
                -->

            </div>

        </div>


        <!-- 審核操作 -->
        <div class="card-footer">

            @if (status != null && status.FId == 1)
            {
                <div class="d-flex justify-content-end gap-2">

                    <form asp-action="Reject" method="post">
                        <input type="hidden"
                               name="id"
                               value="@Model.FId" />

                        <button type="submit"
                                class="btn btn-danger">
                            拒絕申請
                        </button>
                    </form>

                    <form asp-action="Approve" method="post">
                        <input type="hidden"
                               name="id"
                               value="@Model.FId" />

                        <button type="submit"
                                class="btn btn-success">
                            接受申請
                        </button>
                    </form>

                </div>
            }
            else if (status != null)
            {
                <div class="text-end">

                    @if (status.FId == 2)
                    {
                        <span class="badge bg-success fs-6">
                            此申請已接受
                        </span>
                    }
                    else if (status.FId == 3)
                    {
                        <span class="badge bg-danger fs-6">
                            此申請已拒絕
                        </span>
                    }

                </div>
            }

        </div>

    </div>

</div>