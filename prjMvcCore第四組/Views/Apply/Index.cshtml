@model IEnumerable<prjMvcCore第四組.Models.TApply>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">發送審核(測試)</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                商家名
            </th>
            <th>
                用戶名
            </th>
            <th>
                審核狀態
            </th>
            <th>
                發出日期
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FStoreName)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.FUser.FUsername)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FApplyDate)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.FId">Details</a> 
            </td>
        </tr>
}
    </tbody>
</table>
