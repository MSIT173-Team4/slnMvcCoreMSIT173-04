@model prjMvcCoreMSIC173.Models.CRestaurantWrap

@{
    ViewData["Title"] = "Create";
}

<h1 class="text-center">新增推薦店家</h1>

<h4 class="text-center">請輸入店家資訊</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger "></div>

            <div class="form-group">
                <label asp-for="FName" class="control-label"></label>
                <input asp-for="FName" class="form-control" />
                <span asp-validation-for="FName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FCategory" class="control-label"></label>
                <select asp-for="Restaurant.FCategoryId"
                        asp-items="Model.CategoryOptions"
                        class="form-select">
                    <option value="">商家種類</option>
                </select>
                <span asp-validation-for="FCategory" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FAddress" class="control-label"></label>
                <input asp-for="FAddress" class="form-control" />
                <span asp-validation-for="FAddress" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FPhone" class="control-label"></label>
                <input asp-for="FPhone" class="form-control" />
                <span asp-validation-for="FPhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FDescription" class="control-label"></label>
                <input asp-for="FDescription" class="form-control" />
                <span asp-validation-for="FDescription" class="textarea-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FBusinessStatus" class="control-label"></label>
                <input asp-for="FBusinessStatus" class="form-control" />
                <span asp-validation-for="FBusinessStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FIsRecommend" class="control-label"></label>
                <input asp-for="FIsRecommend" class="form-check-input" />
                <span asp-validation-for="FIsRecommend" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="新增推薦商家" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="List">取消新增</a>
</div>
