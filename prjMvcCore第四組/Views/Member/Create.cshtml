@model prjMvcCore第四組.Models.TUser

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>TUser</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FUsername" class="control-label"></label>
                <input asp-for="FUsername" class="form-control" />
                <span asp-validation-for="FUsername" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FNickname" class="control-label"></label>
                <input asp-for="FNickname" class="form-control" />
                <span asp-validation-for="FNickname" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FPassword" class="control-label"></label>
                <input asp-for="FPassword" class="form-control" />
                <span asp-validation-for="FPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FEmail" class="control-label"></label>
                <input asp-for="FEmail" class="form-control" />
                <span asp-validation-for="FEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FIdNum" class="control-label"></label>
                <input asp-for="FIdNum" class="form-control" />
                <span asp-validation-for="FIdNum" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FPhone" class="control-label"></label>
                <input asp-for="FPhone" class="form-control" />
                <span asp-validation-for="FPhone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">性別</label>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="FGender"
                           value="true"
                           id="genderMale" />
                    <label class="form-check-label" for="genderMale">
                        男
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input"
                           type="radio"
                           asp-for="FGender"
                           value="false"
                           id="genderFemale" />
                    <label class="form-check-label" for="genderFemale">
                        女
                    </label>
                </div>

                <span asp-validation-for="FGender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FAddress" class="control-label"></label>
                <input asp-for="FAddress" class="form-control" />
                <span asp-validation-for="FAddress" class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
