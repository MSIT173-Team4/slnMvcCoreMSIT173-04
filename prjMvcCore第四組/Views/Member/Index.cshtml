@model IEnumerable<prjMvcCore第四組.Models.TUser>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
@using (Html.BeginForm())
{
    @:關鍵字： @Html.TextBox("txtKeyword","",new  { @class = "form-control"})
    <input type="submit" value="查詢" />
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FUsername)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FNickname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FEmail)
            </th>
            <th>
            </th>
            <th></th>
        </tr>
