@model IEnumerable<prjMvcCore第四組.Models.TUser>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="container mt-3">
    <form asp-action="Index" method="get">
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex gap-3">
                <div class="form-check">
                    <input class="form-check-input" name="searchType" value="Username" type="radio" id="usernameRadio"  /><label class="form-check-label" for="usernameRadio">Username</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" name="searchType" value="Nickname" type="radio" id="nicknameRadio"/><label class="form-check-label" for="nicknameRadio">Nickname</label>
                </div>
            </div>
            <input type="text" name="txtKeyword" class="form-control" />
            <input type="submit" value="Search" class="btn btn-success" />
        </div>
    </form>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FUsername)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FNickname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FEmail)
            </th>
            <th>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FUsername)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FNickname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FEmail)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.FId">Details</a> 
            </td>
        </tr>
}
    </tbody>
</table>
