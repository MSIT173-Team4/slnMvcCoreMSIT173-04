@model prjMvcCore第四組.ViewModels.PostViewModel

@{
    ViewData["Title"] = Model.Post.FTitle;
    var userDisplayName = string.IsNullOrEmpty(Model.Post.FUser.FNickname) ? Model.Post.FUser.FUsername : Model.Post.FUser.FNickname;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-4" style="max-width: 800px;">

    <h2 class="fw-bold">@Model.Post.FTitle</h2>

    <hr class="my-3 text-secondary opacity-50" />

    <div class="d-flex align-items-center mb-4">
        <i class="bi bi-person-circle fs-3 me-2 text-secondary"></i>
        <span class="fw-bold fs-5 text-dark">@userDisplayName</span>
    </div>

    <div class="post-content mb-4 fs-5 text-break" style="white-space: pre-line; min-height: 120px;">
        @Model.Post.FPostContent
    </div>

    <hr class="my-3 text-secondary opacity-50" />

    <div class="d-flex align-items-center gap-4 mb-4 fs-6 text-secondary">
        <div>
            <i class="bi bi-hand-thumbs-up me-1"></i>
            <span>@Model.Post.FLikes</span>
        </div>
        <div>
            <span>瀏覽量：@Model.Post.FViews</span>
        </div>
        <div>
            <a asp-action="DeletePost" asp-route-id="@Model.Post.FPostId" class="btn btn-outline-danger btn-sm" onclick="return confirm('確定要刪除貼文?')">刪除貼文</a>
        </div>
    </div>

    <div class="bg-light p-3 p-md-4 rounded-3 border">
        <h5 class="fw-bold mb-3 text-secondary">留言區</h5>

        <div class="comment-list mb-4">
            @if (!Model.Messages.Any())
            {
                <p class="text-muted text-center py-3">尚無留言</p>
            }
            else
            {
                @foreach (var item in Model.Messages)
                {
                    var msgUserDisplayName = string.IsNullOrEmpty(item.Message.FUser.FNickname)
                        ? item.Message.FUser.FUsername
                        : item.Message.FUser.FNickname;

                    <div class="bg-white p-3 rounded mb-3 border shadow-sm">
                        <div class="d-flex align-items-start mb-2">
                            <i class="bi bi-person-circle fs-4 me-2 text-secondary flex-shrink-0"></i>
                            <div>
                                <span class="fw-bold me-2">@msgUserDisplayName</span>
                                <span>
                                    @if (!string.IsNullOrEmpty(item.ReplyToUsername))
                                    {
                                        <span class="text-primary fw-bold me-1">@@@item.ReplyToUsername</span>
                                    }
                                    @item.Message.FMessageContent
                                </span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-3 ms-4 ps-2 fs-7 text-secondary">
                            <span>
                                <i class="bi bi-hand-thumbs-up me-1"></i>@item.Message.FLikes
                            </span>
                            <button type="button" class="btn btn-link p-0 text-decoration-none text-secondary fs-7">
                                回覆
                            </button>
                            <a asp-action="DeleteComment" asp-route-postId="@item.Message.FPostId" asp-route-id="@item.Message.FMessageId" class="btn btn-outline-danger btn-sm" onclick="return confirm('確定要刪除嗎?')">刪除</a>
                            <small class="text-muted ms-auto">@item.Message.FMessageDate.ToString("yyyy/MM/dd HH:mm")</small>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="bg-white p-2 rounded border">
            <form asp-action="AddComment" method="post" class="d-flex align-items-center gap-2">
                <input type="hidden" name="postId" value="@Model.Post.FPostId" />

                <i class="bi bi-person-circle fs-3 text-secondary"></i>
                <input type="text"
                       name="messageContent"
                       class="form-control border-0 bg-light"
                       placeholder="留言..."
                       required autocomplete="off" />
                <button type="submit" class="btn btn-primary px-4">傳送</button>
            </form>
        </div>
    </div>
</div>