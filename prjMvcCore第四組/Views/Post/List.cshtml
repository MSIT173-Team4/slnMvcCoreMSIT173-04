@model IEnumerable<prjMvcCore第四組.Models.TPostTable>

@{
    ViewData["Title"] = "List";
    string currentSort = ViewBag.CurrentSort != null ? ViewBag.CurrentSort.ToString() : "latest";
}

<div class="container mt-4">
    <h2 class="mb-4">貼文</h2>
    <br />
    <div class="d-flex align-items-center gap-3">

    <form method="get" asp-action="List" class="d-flex align-items-center gap-2">
        <label for="sortBy" class="form-label mb-0 text-nowrap text-secondary">
            排序方式：
        </label>

        <select name="sortBy"
                id="sortBy"
                class="form-select form-select-sm"
                style="width: 140px;"
                onchange="this.form.submit()">

            <option value="latest" selected="@(currentSort == "latest")">
                最新
            </option>

            <option value="popular" selected="@(currentSort == "popular")">
                最熱門
            </option>
        </select>
    </form>
    <form method="post" class="d-flex align-items-center gap-2">
        <input type="text"
               name="PostKeyword"
               class="form-control form-control-sm"
               placeholder="輸入關鍵字..."
               style="width: 200px;" />
        <input type="submit"
               value="查詢貼文"
               class="btn btn-primary btn-sm" />
    </form>
</div>
    
    <br />
    <div class="list-group">
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action p-3 mb-3 border rounded shadow-sm">
                <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                    <h5 class="mb-1 fw-bold">
                        <a asp-action="Detail" asp-route-id="@item.FPostId" class="text-decoration-none text-dark">
                            @item.FTitle
                        </a>
                    </h5>
                    <small class="text-muted">@item.FPostDate.ToString("yyyy/MM/dd HH:mm")</small>
                </div>

                <p class="mb-2 text-secondary">
                    <i class="bi bi-person-circle me-1"></i>
                    @(string.IsNullOrEmpty(item.FUser.FNickname) ? item.FUser.FUsername : item.FUser.FNickname)
                </p>

                <div class="d-flex justify-content-between align-items-center mt-3 fs-6 text-muted">
                    <div>
                        <span class="me-3"><i class="bi bi-hand-thumbs-up"></i> @item.FLikes 讚</span>
                        <span><i class="bi bi-eye"></i> 瀏覽量：@item.FViews</span>
                    </div>
                    <a asp-action="Detail" asp-route-id="@item.FPostId" class="btn btn-outline-primary btn-sm">查看</a>
                </div>
            </div>
        }
    </div>
</div>