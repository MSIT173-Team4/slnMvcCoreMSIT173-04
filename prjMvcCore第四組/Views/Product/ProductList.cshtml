@model IEnumerable<prjMvcCore第四組.Models.CProductWrap>

@{
    ViewData["Title"] = "商品清單";
    
    var searchType = Context.Request.Query["SearchType"].ToString();
    var txtKeyword = Context.Request.Query["txtKeyword"].ToString();
    var minStock = Context.Request.Query["MinStock"].ToString();
    var maxStock = Context.Request.Query["MaxStock"].ToString();
    var statusFilter = Context.Request.Query["StatusFilter"].ToString();
}

<h1>商品清單</h1>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="ProductList">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="SearchType" class="form-label fw-bold">搜尋條件</label>
                    <select name="SearchType" id="SearchType" class="form-select">
                        <option value="merchantId" selected="@(searchType == "merchantId")">商家ID</option>
                        <option value="productId" selected="@(searchType == "productId")">產品編號</option>
                        <option value="productName" selected="@(searchType == "productName")">產品名稱</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="txtKeyword" class="form-label fw-bold">關鍵字</label>
                    <input type="text" name="txtKeyword" id="txtKeyword" class="form-control"
                           value="@txtKeyword" placeholder="請輸入搜尋關鍵字...">
                </div>
                <div class="col-md-2">
                    <label for="StatusFilter" class="form-label fw-bold">狀態</label>
                    <select name="StatusFilter" id="StatusFilter" class="form-select">
                        <option value="">全部</option>
                        <option value="0" selected="@(statusFilter == "0")">審核中</option>
                        <option value="1" selected="@(statusFilter == "1")">架上商品</option>
                        <option value="2" selected="@(statusFilter == "2")">已售完</option>
                        <option value="3" selected="@(statusFilter == "3")">未上架</option>
                        <option value="4" selected="@(statusFilter == "4")">已違規</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-px-120 me-3">搜尋</button>
                    <a asp-action="ProductList" class="btn btn-secondary  w-px-120">清除條件</a>
                </div>
                                
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label for="MinStock" class="form-label fw-bold">庫存大於</label>
                    <input type="number" name="MinStock" id="MinStock" class="form-control"
                           value="@minStock" placeholder="不限">
                </div>
                <div class="col-md-4">
                    <label for="MaxStock" class="form-label fw-bold">庫存小於</label>
                    <input type="number" name="MaxStock" id="MaxStock" class="form-control"
                           value="@maxStock" placeholder="不限">
                </div>
               
                
            </div>
        </form>
    </div>
</div>


<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>商家編號</th>
            <th>商品編號</th>
            <th>商品名稱</th>
            <th>單價</th>
            <th>庫存</th>
            <th>狀態</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.FSellerId</td>
                    <td>@item.FProductNo</td>
                    <td>@item.FProductname</td>
                    <td>@item.FPrice</td>
                    <td>@item.FStock</td>
                    <td>@item.FProductStatusText</td>
                    <td>
                        
                        @if (item.FProductStatus == 1)
                        {
                            <form asp-action="ToggleStatus" asp-route-id="@item.FProductId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-warning">下架</button>
                            </form>
                        }
                        else if (item.FProductStatus == 3)
                        {
                            <form asp-action="ToggleStatus" asp-route-id="@item.FProductId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">上架</button>
                            </form>
                        }


                        else
                        {
                            <button type="button" class="btn btn-sm btn-secondary" disabled>@item.FProductStatusText</button>
                        }
                        
                        <a asp-action="Edit" asp-route-id="@item.FProductId" class="btn btn-sm btn-primary">編輯</a>
                        <a asp-action="Delete" asp-route-id="@item.FProductId" class="btn btn-sm btn-danger" onclick="return confirm('確定要刪除嗎?')">刪除</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>