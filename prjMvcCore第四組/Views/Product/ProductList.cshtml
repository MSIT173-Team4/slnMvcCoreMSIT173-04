@model IEnumerable<prjMvcCore第四組.Models.TProduct>

@{
    ViewData["Title"] = "商品清單";
}

<h1>商品清單</h1>

<table class="table table-striped table-hover mt-3">
    <thead>
        <tr>
            <th>商品編號</th>
            <th>商品名稱</th>
            <th>單價</th>
            <th>庫存</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.FProductNo</td>
                    <td>@item.FProductname</td>
                    <td>@item.FPrice</td>
                    <td>@item.FStock</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.FProductId" class="btn btn-sm btn-primary">編輯</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>