@model IEnumerable<prjMvcCore第四組.Models.CRecipeWrap>

@{
    ViewData["Title"] = "RecipeList";
}

<h1>食譜資料一覽表</h1>

<form method="post">
    關鍵字： <input type="text" name="txtKeyword" />
    <input type="submit" value="查詢" />
</form>

<p>
    <a asp-action="Create">新增食譜</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                序
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FDefaultServings)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FTotalCookingMinutes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Photo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int count = 0;
            foreach (var item in Model)
            {
                count++;
                <tr>
                    <td>
                        @count
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FTitle)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FDescription)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FDefaultServings)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FTotalCookingMinutes)
                    </td>
                    <td>
                        <img src="~/images/@item.FCoverImageUrl" width="60" height="40" />
                    </td>
                    <td>
                        @Html.ActionLink("修改", "Edit", new { id = item.FRecipeId }) |
                        @Html.ActionLink("刪除", "Delete", new { id = item.FRecipeId }, new { onclick = "return confirm('確定要刪除嗎?')" })
                    </td>
                </tr>
            }
        }
    </tbody>
</table>