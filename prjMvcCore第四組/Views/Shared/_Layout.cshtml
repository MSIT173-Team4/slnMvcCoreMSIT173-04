<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - prjMvcCore第四組</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/prjMvcCore第四組.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/vendors/iconly/bold.css">
    <link rel="stylesheet" href="~/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">
    
</head>
<body>
    
        <div class="d-flex" id="wrapper">
            <!-- 側邊欄 (Sidebar) -->
            <div class="border-end bg-white" id="sidebar-wrapper">
                <div class="sidebar-heading border-bottom bg-light px-3 py-3 fw-bold">
                    <a class="text-decoration-none text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                        prjMvcCore第四組
                    </a>
                </div>
            
            
                <div class="list-group list-group-flush">
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house"></i>主頁面
                    <i class="fa-solid fa-bars align-right"></i>
                    </a>
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">
                    <i class="fa-solid fa-user"></i>會員管理
                    <i class="fa-solid fa-bars align-right"></i>
                    </a>
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-file-lines"></i>貼文管理
                    <i class="fa-solid fa-bars align-right"></i>
                </a>
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-book"></i>食譜管理
                    <i class="fa-solid fa-bars align-right"></i>
                </a>
                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-cart-shopping"></i>商城管理
                    <i class="fa-solid fa-bars align-right"></i>
                </a>
                <a  class="nav-link text-dark text" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-map-location-dot"></i>美食地圖
                    <i class="fa-solid fa-bars align-right"></i>
                </a>
                </div>
            </div>


            <!-- 主要頁面區域 (Page Content) -->
            <div id="page-content-wrapper" class="w-100 d-flex flex-column min-vh-100">
                <!-- 頂部導覽列 (Header / Navbar) -->
                <header>
                    <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom px-3">
                        <div class="container-fluid">
                            <button class="btn btn-outline-secondary btn-sm" id="sidebarToggle">
                                <i class="bi bi-list"></i>
                            </button>

                            <div class="ms-auto d-flex align-items-center">
                                <span class="navbar-text me-3">
                                    歡迎使用後台系統
                                </span>
                            </div>
                        </div>
                    </nav>
                </header>

                <!-- 主要內容區 (Main Body) -->
                <div class="container-fluid p-4 flex-grow-1">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>

                <!-- 頁尾 (Footer) -->
                <footer class="border-top footer text-muted bg-light py-3 mt-auto">
                    <div class="container-fluid px-4 text-center text-md-start">
                        &copy; @DateTime.Now.Year - prjMvcCore第四組 -
                        <a class="text-decoration-none text-muted" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </footer>
            </div>
        </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
